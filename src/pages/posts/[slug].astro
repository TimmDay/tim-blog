---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  formatDate,
  getVisiblePosts,
  postUrl,
  type Post,
} from '../../lib/posts';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

type Props = { post: Post };
const { post } = Astro.props;
const { title, summary, date, updated, tags, canonicalUrl, draft } = post.data;
const { Content } = await render(post);

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: new URL(postUrl(post), site.url).href,
  image: new URL(`/og/${post.id}.png`, site.url).href,
  keywords: tags,
  author: { '@type': 'Person', name: site.author, url: site.url },
};
---

<Base
  title={title}
  description={summary}
  ogImage={`/og/${post.id}.png`}
  canonicalUrl={canonicalUrl}
  type="article"
  jsonLd={blogPosting}
>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="muted meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && (
          <>
            {' · Updated '}
            <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
          </>
        )}
        {draft && ' · Draft'}
      </p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .meta {
    margin: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
  }

  .tags li {
    padding: 0.1rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
  }

  .prose {
    margin-top: 2rem;
  }

  .prose :global(figure) {
    margin: 2rem 0;
  }

  .prose :global(figcaption) {
    color: var(--muted);
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }
</style>
