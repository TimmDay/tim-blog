---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostSidebar from '../../components/PostSidebar.astro';
import {
  formatDate,
  getVisiblePosts,
  postUrl,
  type Post,
} from '../../lib/posts';
import { site } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, recent: posts.filter((p) => p !== post).slice(0, 5) },
  }));
}

type Props = { post: Post; recent: Post[] };
const { post, recent } = Astro.props;
const { title, summary, date, updated, tags, canonicalUrl, draft } = post.data;
const { Content } = await render(post);

const blogPosting = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  url: new URL(postUrl(post), site.url).href,
  image: new URL(`/og/${post.id}.png`, site.url).href,
  keywords: tags,
  author: { '@type': 'Person', name: site.author, url: site.url },
};
---

<Base
  width="wide"
  title={title}
  description={summary}
  ogImage={`/og/${post.id}.png`}
  canonicalUrl={canonicalUrl}
  type="article"
  jsonLd={blogPosting}
>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        Published on{' '}
        <time datetime={date.toISOString()}>{formatDate(date)}</time>.
        {updated && (
          <>
            {' Updated '}
            <time datetime={updated.toISOString()}>{formatDate(updated)}</time>.
          </>
        )}
        {tags.length > 0 && ` ${tags.join(', ')}.`}
        {draft && ' Draft.'}
      </p>
    </header>
    <div class="body">
      <div class="prose">
        <Content />
      </div>
      <PostSidebar recent={recent} />
    </div>
  </article>
</Base>

<style>
  .meta {
    color: var(--color-muted);
    margin: 0 0 var(--space-4);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, var(--width-prose)) var(--width-sidebar);
    justify-content: space-between;
    gap: var(--space-12);
  }

  @media (max-width: 60rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
