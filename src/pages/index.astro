---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ArrowLink from '../components/ui/ArrowLink.astro';
import { getVisiblePosts } from '../lib/posts';
import { site } from '../lib/site';

const posts = await getVisiblePosts();
const recent = posts.slice(0, 10);
---

<Base>
  <h1 class="visually-hidden">{site.author}</h1>

  <!-- Placeholder copy: Tim to replace. Keep the links: they do the hiring work. -->
  <p class="intro">
    Hi, I'm <a href="/about/">{site.author}</a>. Lorem ipsum dolor sit amet,
    consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore. If
    you're hiring, <a href="/contact/">let's talk</a> or grab{' '}
    <a href="/contact/">my CV</a>. You can also follow along via{' '}
    <a href="/rss.xml">RSS</a>.
  </p>

  {recent.length > 0 && (
    <section aria-label="Recent Posts">
      <PostList posts={recent} />
      {posts.length > recent.length && (
        <p>
          <ArrowLink href="/posts/">All Posts</ArrowLink>
        </p>
      )}
    </section>
  )}
</Base>

<style>
  .intro {
    max-width: var(--width-prose);
    margin: var(--space-4) auto var(--space-16);
    line-height: var(--leading-normal);
  }
</style>
