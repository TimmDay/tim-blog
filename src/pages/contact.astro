---
import Base from '../layouts/Base.astro';
import { cvVariants, profileLinks, site } from '../lib/site';
---

<Base
  title="Contact"
  description={`How to reach ${site.author}, and CV downloads.`}
>
  <h1>Contact</h1>

  <h2>Find me on</h2>
  <ul>
    {profileLinks.map((link) => (
      <li>
        <a href={link.href} rel="me">
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <h2>CV</h2>
  <ul class="cvs">
    {cvVariants.map((cv) => (
      <li>
        <a class="cv" href={cv.href} download>
          {cv.role} CV <span class="muted">(PDF)</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .cvs {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .cv {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
    text-decoration: none;
    font-weight: 600;
  }

  .cv:hover {
    background: var(--surface);
  }
</style>
