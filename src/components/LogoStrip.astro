---
/**
 * Places Tim has worked. Each entry shows its logo, or its name as text until
 * a logo image is added.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type Employer = { name: string; logo?: ImageMetadata };
type Props = { items: Employer[] };
const { items } = Astro.props;
---

<ul aria-label="Places I've worked">
  {items.map((item) => (
    <li>
      {item.logo ? (
        <Image src={item.logo} alt={item.name} height={40} />
      ) : (
        <span>{item.name}</span>
      )}
    </li>
  ))}
</ul>

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: var(--space-8) 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
  }

  li {
    color: var(--color-muted);
    font-weight: var(--weight-bold);
    font-size: var(--text-base);
  }

  li :global(img) {
    height: 40px;
    width: auto;
    filter: grayscale(1);
    opacity: 0.7;
  }
</style>
