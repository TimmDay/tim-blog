---
import { formatDate, postUrl, type Post } from '../lib/posts';

type Props = { posts: Post[]; headingLevel?: 2 | 3 };
const { posts, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
---

{posts.length === 0 ? (
  <p class="muted">No Posts yet.</p>
) : (
  <ul>
    {posts.map((post) => (
      <li>
        <Heading class="title">
          <a href={postUrl(post)}>{post.data.title}</a>
        </Heading>
        <p class="muted meta">
          <time datetime={post.data.date.toISOString()}>
            {formatDate(post.data.date)}
          </time>
          {post.data.draft && ' · Draft'}
        </p>
        <p>{post.data.summary}</p>
      </li>
    ))}
  </ul>
)}

<style>
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li + li {
    margin-top: 2rem;
  }

  .title {
    margin: 0;
    font-size: 1.25rem;
  }

  p {
    margin: 0.25rem 0 0;
  }

  .meta {
    font-size: 0.95rem;
  }
</style>
