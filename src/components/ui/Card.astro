---
/** The white panel every block of content sits on. */
type Props = {
  as?: 'div' | 'section' | 'article';
  label?: string;
};

const { as: Tag = 'div', label } = Astro.props;
---

<Tag class="card" aria-label={label}>
  <div class="inner">
    <slot />
  </div>
</Tag>

<style>
  .card {
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    box-shadow: var(--shadow-card);
    margin-bottom: var(--space-8);
    padding: var(--space-16) var(--gutter);
  }

  .inner {
    max-width: var(--width-prose);
    margin: 0 auto;
  }

  .inner > :global(:first-child) {
    margin-top: 0;
  }

  .inner > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Full-bleed on phones, like andykelk.net. */
  @media (max-width: 54.375rem) {
    .card {
      border-inline: none;
    }
  }
</style>
