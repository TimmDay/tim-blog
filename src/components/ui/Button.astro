---
/**
 * A button, or a link styled as one when `href` is set.
 * Use `primary` for the single main action on a page, `secondary` for the rest.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  variant?: 'primary' | 'secondary';
  href?: string;
  download?: boolean;
  type?: HTMLAttributes<'button'>['type'];
};

const { variant = 'primary', href, download, type = 'button' } = Astro.props;
---

{href ? (
  <a class:list={['btn', variant]} href={href} download={download}>
    <slot />
  </a>
) : (
  <button class:list={['btn', variant]} type={type}>
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-link);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s,
      color 0.15s;
  }

  .primary {
    background: var(--color-link);
    color: var(--color-on-accent);
  }

  .primary:hover {
    background: var(--color-link-hover);
    border-color: var(--color-link-hover);
    color: var(--color-on-accent);
  }

  .secondary {
    background: transparent;
    color: var(--color-link);
  }

  .secondary:hover {
    background: var(--color-bg);
    color: var(--color-link-hover);
    border-color: var(--color-link-hover);
  }
</style>
