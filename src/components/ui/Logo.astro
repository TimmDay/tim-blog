---
/** The TD lettermark. Same artwork as public/favicon.svg; colours follow the theme. */
type Props = { size?: number };
const { size = 30 } = Astro.props;
---

<svg
  class="logo"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 200 200"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <circle class="disc" cx="100" cy="100" r="95"></circle>
  <g class="letters">
    <rect x="34" y="58" width="82" height="10"></rect>
    <rect x="70" y="58" width="10" height="88"></rect>
    <path
      fill-rule="evenodd"
      d="M122 58h26a44 44 0 0 1 0 88h-26zm10 10v68h16a34 34 0 0 0 0-68z"
    ></path>
  </g>
</svg>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
  }

  .disc {
    fill: var(--color-brand);
  }

  .letters {
    fill: var(--color-on-brand);
  }
</style>
