---
/**
 * Light/dark switch. Follows the OS until clicked, then remembers the choice
 * in localStorage. Hidden without JS, where the OS setting still applies.
 * The saved choice is applied before first paint by the inline script in Base.astro.
 */
---

<button type="button" class="theme-toggle" hidden aria-label="Switch theme">
  <svg
    class="moon"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
  >
    <path
      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></path>
  </svg>
  <svg
    class="sun"
    viewBox="0 0 24 24"
    width="20"
    height="20"
    aria-hidden="true"
  >
    <g
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </g>
  </svg>
</button>

<script>
  import { initThemeToggle } from '../lib/theme';

  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  if (button) initThemeToggle(button);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-link);
    border-color: var(--color-link);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  /* Show the theme you'd switch to. */
  .theme-toggle[data-current='light'] .sun,
  .theme-toggle[data-current='dark'] .moon {
    display: none;
  }
</style>
