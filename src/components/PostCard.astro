---
import { formatDate, postUrl, type Post } from '../lib/posts';
import ArrowLink from './ui/ArrowLink.astro';
import Card from './ui/Card.astro';

type Props = { post: Post; headingLevel?: 2 | 3 };
const { post, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as const;
const { title, date, summary, draft } = post.data;
---

<Card as="article">
  <div class="summary">
    <Heading class="title">
      <a href={postUrl(post)}>{title}</a>
    </Heading>
    <p class="date">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {draft && ' · Draft'}
    </p>
    <p class="excerpt">{summary}</p>
    <p class="more">
      <ArrowLink href={postUrl(post)}>
        Continue reading<span class="visually-hidden">: {title}</span>
      </ArrowLink>
    </p>
  </div>
</Card>

<style>
  .summary {
    text-align: center;
  }

  .title {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
  }

  .title a {
    color: var(--color-heading);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-link);
  }

  .date {
    color: var(--color-muted);
    font-size: var(--text-base);
    margin: 0;
  }

  .excerpt {
    font-size: var(--text-base);
    margin: var(--space-8) 0;
  }

  .more {
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
