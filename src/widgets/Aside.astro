---
/**
 * An expandable aside. Built on <details>, so it needs no JS and is its own
 * Fallback: RSS readers and screen readers get the same content.
 */
type Props = { summary: string };
const { summary } = Astro.props;
---

<details>
  <summary>{summary}</summary>
  <aside>
    <slot />
  </aside>
</details>

<style>
  details {
    margin: 2rem 0;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
  }

  summary {
    cursor: pointer;
    font-weight: 600;
  }

  aside {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
</style>
